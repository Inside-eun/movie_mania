<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moviemania.instagram-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/choedam-eun/.nvm/versions/node/v18.20.8/bin/npx</string>
    <string>tsx</string>
    <string>src/scripts/scan-instagram-events.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/choedam-eun/.nvm/versions/node/v18.20.8/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 매주 월요일 07:30 실행. 요일을 바꾸려면 Weekday 값을 수정 (0/7=일, 1=월 ... 6=토) -->
