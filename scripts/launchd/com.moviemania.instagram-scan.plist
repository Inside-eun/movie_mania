  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.instagram-scan/log.txt</string>

  <key>StandardErrorPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.instagram-scan/log.txt</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
