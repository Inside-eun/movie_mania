<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moviemania.instagram-scan</string>

  <!-- 스캔 후 기획전 자동 반영(검증 통과분만 main 배포)까지 이어서 실행. PATH는 스크립트 안에서 지정. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>scripts/instagram-scan.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania</string>

  <!-- 30분마다 깨우고, 실제 스캔은 주 1회(월요일 07:30 이후 첫 깨어 있는 시점)만 한다.
       요일·시각을 바꾸려면 scripts/instagram-scan.sh의 PERIOD 계산을 수정. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.instagram-scan/log.txt</string>

  <key>StandardErrorPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.instagram-scan/log.txt</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
