<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moviemania.instagram-scan</string>

  <!-- 스캔 후 기획전 자동 반영(검증 통과분만 main 배포)까지 이어서 실행. PATH는 스크립트 안에서 지정. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>scripts/instagram-scan.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania</string>

  <!-- 매주 월요일 07:30 실행. 요일을 바꾸려면 Weekday 값을 수정 (0/7=일, 1=월 ... 6=토) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.instagram-scan/log.txt</string>

  <key>StandardErrorPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.instagram-scan/log.txt</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
