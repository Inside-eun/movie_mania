<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moviemania.cgv-movno</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/choedam-eun/.nvm/versions/node/v22.23.2/bin/npx</string>
    <string>tsx</string>
    <string>src/scripts/batchFetchCgvMovNo.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania</string>

  <!-- scheduleService.js가 쓰는 cheerio/undici가 Node 18의 전역 File 누락으로
       깨져서(ReferenceError: File is not defined) Node 22가 반드시 필요함. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/choedam-eun/.nvm/versions/node/v22.23.2/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 매일 06:00 실행. 그날 CGV 상영작 movNo를 미리 채워둬서, 사용자가 예매
       버튼을 누르는 시점엔 대부분 캐시가 이미 채워져 있게 한다. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.cgv-movno/log.txt</string>

  <key>StandardErrorPath</key>
  <string>/Users/choedam-eun/Desktop/work/Movie/movie_mania/.cgv-movno/log.txt</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
