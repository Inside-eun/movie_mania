# API Keys for Movie Schedule App
# Copy this file to .env.local and fill in your actual API keys

# KOBIS API Key (영화진흥위원회)
KOBIS_API_KEY=609eba269acb357be05be4ec60202702

# KMDB API Key (한국영상자료원)
KMDB_API_KEY=23QYU3V707Y5O2M7R25J

# TMDB API Key (The Movie Database)
TMDB_API_KEY=your_tmdb_api_key_here

# Cache TTL in hours (기본값: 6시간)
CACHE_TTL_HOURS=6

# Kakao Maps JavaScript key (https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키)
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_javascript_key_here

# 인스타그램 기획전 스캔 스크립트(src/scripts/scan-instagram-events.ts) 전용.
# 반드시 이 용도로만 쓸 별도 계정으로 발급 — 개인 계정 사용 금지.
IG_SCRAPER_USERNAME=your_dedicated_scraper_account_username
IG_SCRAPER_PASSWORD=your_dedicated_scraper_account_password

# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXXX

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# GA4 Data API용 서비스 계정 키 (Google Cloud Console > IAM 및 관리자 > 서비스 계정에서 발급).
# JSON 키 파일을 그대로 쓰지 말고 client_email / private_key만 분리해서 등록.
# 로컬은 .env.local에, 배포용은 Vercel 프로젝트 Settings > Environment Variables에 동일 값으로 등록.
GA4_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GA4_PROPERTY_ID=your_ga4_property_id_here

# /api/analytics/* 외부 호출용 토큰(Authorization: Bearer <값>).
# 값이 없으면 해당 API는 전부 차단된다. /analytics 대시보드는 이 토큰을 쓰지 않는다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ANALYTICS_TOKEN=your_random_token_here

# /analytics 대시보드 로그인 비밀번호.
ANALYTICS_PASSWORD=your_dashboard_password_here

# 로그인 세션 쿠키 서명용 키. 값을 바꾸면 기존 로그인 세션이 모두 만료된다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ANALYTICS_SESSION_SECRET=your_random_secret_here
